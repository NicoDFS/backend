// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                    String    @id @default(uuid())

  // Project Information (from form)
  name                  String
  description           String    @db.Text
  websiteUrl            String?
  whitepaperUrl         String?
  githubUrl             String?
  discordUrl            String?
  telegramUrl           String?
  twitterUrl            String?
  additionalSocialUrl   String?

  // Presale Configuration (from form)
  saleToken             String
  baseToken             String
  tokenRate             String
  liquidityRate         String
  minContribution       String?
  maxContribution       String?
  softCap               String
  hardCap               String
  liquidityPercent      String
  presaleStart          DateTime
  presaleEnd            DateTime
  lpLockDuration        String
  lpRecipient           String?

  // DEX version for liquidity deployment
  dexVersion            String    @default("v3")  // always "v3" on 3890 (no V2 router exists there)

  // Blockchain Data (required for save)
  contractAddress       String    @unique  // Deployed presale contract address
  transactionHash       String    @unique  // Creation transaction hash
  blockNumber           Int                // Block where contract was deployed
  deployedAt            DateTime           // When contract was successfully deployed

  // Metadata
  createdAt             DateTime  @default(now())

  // Deployer of the sale contract, proven from the tx receipt (lower-cased). This is
  // the only ownership the launchpad has — there are no user accounts.
  ownerAddress          String

  @@index([ownerAddress])
  @@index([contractAddress])
  @@index([transactionHash])
}

model FairlaunchProject {
  id                    String    @id @default(uuid())

  // Project Information (from form)
  name                  String
  description           String    @db.Text
  websiteUrl            String?
  whitepaperUrl         String?
  githubUrl             String?
  discordUrl            String?
  telegramUrl           String?
  twitterUrl            String?
  additionalSocialUrl   String?

  // Fairlaunch Configuration (from form)
  saleToken             String
  baseToken             String
  buybackRate           String
  sellingAmount         String
  softCap               String
  liquidityPercent      String
  fairlaunchStart       DateTime
  fairlaunchEnd         DateTime
  isWhitelist           Boolean   @default(false)
  referrer              String?

  // DEX version for liquidity deployment
  dexVersion            String    @default("v3")  // always "v3" on 3890 (no V2 router exists there)

  // Blockchain Data (required for save)
  contractAddress       String    @unique  // Deployed fairlaunch contract address
  transactionHash       String    @unique  // Creation transaction hash
  blockNumber           Int                // Block where contract was deployed
  deployedAt            DateTime           // When contract was successfully deployed

  // Metadata
  createdAt             DateTime  @default(now())

  // Deployer of the sale contract, proven from the tx receipt (lower-cased). This is
  // the only ownership the launchpad has — there are no user accounts.
  ownerAddress          String

  @@index([ownerAddress])
  @@index([contractAddress])
  @@index([transactionHash])
}
