# KalySwap backend — copy to .env.local. Every variable the code reads is listed here.

# Postgres (launchpad project metadata via Prisma). Local docker-compose default:
DATABASE_URL="postgresql://kalyswap:kalyswap_password@localhost:5433/kalyswap_db"

# KalyChain (chain id 3890, native KMT).
# RPC: mainrpc.kalychain.io is the production hostname and already serves 3890 —
# nothing to change on cut day. (The old testnetrpc.* record was retired 2026-09-07.)
KALYCHAIN_RPC_URL="https://mainrpc.kalychain.io/rpc"
# EXPLORER: kalyscan.io still serves the OLD 3888 chain until the cut. testnet.kalyscan.io
# is the 3890 explorer today — CUT DAY: switch this to https://kalyscan.io AFTER the DNS flip.
KALYCHAIN_EXPLORER_URL="https://testnet.kalyscan.io"

# Graph node serving bridge-subgraph-kmt / staking-subgraph-kmt / launchpad-subgraph-kmt
GRAPH_NODE_URL="http://localhost:8000"

# Hyperlane monitoring (Prometheus endpoints of the relayer + validators)
RELAYER_PROMETHEUS_URL="http://localhost:9090"
VALIDATOR_KALYCHAIN_PROMETHEUS_URL="http://localhost:9091"
VALIDATOR_ARBITRUM_PROMETHEUS_URL="http://localhost:9093"
VALIDATOR_POLYGON_PROMETHEUS_URL="http://localhost:9094"

# Optional: SMTP for node-down alert emails (when NODE_ENV=development the alert is only logged, not sent)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="alerts@example.com"
SMTP_PASS="password"
ALERT_FROM_EMAIL="alerts@example.com"
ALERT_TO_EMAIL="admin@example.com"
